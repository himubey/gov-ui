{
  "name": "@gov-ui/react",
  "version": "0.0.0",
  "description": "Typed React components for GOV UI. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
