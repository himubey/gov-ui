{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,

    // Resolve @gov-ui/react to source, so this typechecks the public API
    // exactly as a consumer would experience it. If a prop is missing or
    // wrongly typed, the example stops compiling — which is a far more
    // honest test of the API than reading it.
    "baseUrl": ".",
    "paths": {
      "@gov-ui/react": ["../../packages/react/src/index.ts"]
    }
  },
  "include": ["."]
}
